<Window x:Class="WorkExe.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WorkExe 设置" Height="620" Width="520"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Background="#FFF7F7FA" ShowInTaskbar="True" Topmost="True">
    <Window.Resources>
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect ShadowDepth="0" BlurRadius="8" Opacity="0.08" Color="#FF888888"/>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#FF333344"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#FF555566"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#FF6C7BFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="22,9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#FF555566"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="18,9"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#FFDDDDE5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
            <StackPanel>
                <!-- 人物形象 -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="人物形象" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="老板照片（放入 assets 目录后重新生成素材）" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtPhoto" Grid.Column="0" Height="30" Padding="6,4"
                                     VerticalContentAlignment="Center" FontSize="12" Margin="0,0,8,0"/>
                            <Button x:Name="BtnBrowse" Grid.Column="1" Content="浏览..."
                                    Style="{StaticResource GhostButton}" Click="BtnBrowse_Click"/>
                        </Grid>
                        <Button x:Name="BtnRegenerate" Content="用当前照片重新生成动作素材"
                                Style="{StaticResource GhostButton}" HorizontalAlignment="Left"
                                Click="BtnRegenerate_Click"/>
                        <TextBlock x:Name="TxtPhotoStatus" FontSize="11" Foreground="#FF8899AA" Margin="0,8,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- 显示 -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="显示" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="人物大小" Style="{StaticResource Label}" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <RadioButton x:Name="RbSmall" Content="小" GroupName="Size" Margin="0,0,18,0" FontSize="12"/>
                            <RadioButton x:Name="RbMedium" Content="中" GroupName="Size" Margin="0,0,18,0" FontSize="12"/>
                            <RadioButton x:Name="RbLarge" Content="大" GroupName="Size" FontSize="12"/>
                        </StackPanel>

                        <TextBlock Text="不透明度" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="SliderOpacity" Grid.Column="0" Minimum="0.3" Maximum="1.0"
                                    TickFrequency="0.05" IsSnapToTickEnabled="True" Margin="0,0,10,0"
                                    ValueChanged="SliderOpacity_ValueChanged"/>
                            <TextBlock x:Name="TxtOpacity" Grid.Column="1" Text="100%" Width="44"
                                       FontSize="12" Foreground="#FF555566" TextAlignment="Right"/>
                        </Grid>

                        <CheckBox x:Name="ChkTopmost" Content="始终置顶（常驻悬浮）" FontSize="12" Margin="0,0,0,8"/>
                        <CheckBox x:Name="ChkTaskbar" Content="在任务栏显示图标" FontSize="12" Margin="0,0,0,8"/>
                        <CheckBox x:Name="ChkAutoStart" Content="开机自动启动" FontSize="12"/>
                    </StackPanel>
                </Border>

                <!-- 台词 -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="台词（每行一句，随机抽取）" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="受击 / 鞭子抽打时" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtHitLines" Height="56" AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" FontSize="12" Padding="6" Margin="0,0,0,10"/>
                        <TextBlock Text="大炮蓄力时" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtCannonLines" Height="56" AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" FontSize="12" Padding="6" Margin="0,0,0,10"/>
                        <TextBlock Text="牛出现时" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtCowLines" Height="42" AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" FontSize="12" Padding="6" Margin="0,0,0,10"/>
                        <TextBlock Text="说“我错了”时" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtSorryLines" Height="56" AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" FontSize="12" Padding="6"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- 底部按钮 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="BtnReset" Content="恢复默认" Style="{StaticResource GhostButton}"
                    Margin="0,0,10,0" Click="BtnReset_Click"/>
            <Button x:Name="BtnCancel" Content="取消" Style="{StaticResource GhostButton}"
                    Margin="0,0,10,0" Click="BtnCancel_Click"/>
            <Button x:Name="BtnSave" Content="保存并应用" Style="{StaticResource PrimaryButton}"
                    Click="BtnSave_Click"/>
        </StackPanel>
    </Grid>
</Window>
