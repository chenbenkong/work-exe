<Window x:Class="WorkExe.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WorkExe" Height="260" Width="200"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        SourceInitialized="Window_SourceInitialized">
    <Grid x:Name="RootGrid" Background="{x:Null}">
        <Image x:Name="CharacterImage" Stretch="Uniform" IsHitTestVisible="True"
               HorizontalAlignment="Left" VerticalAlignment="Top"
               Width="160" Height="200"/>
        <Border x:Name="BubbleBorder" Background="#FFFFF0F5" CornerRadius="12" Padding="10,6"
                BorderBrush="#FFFF69B4" BorderThickness="1" Visibility="Collapsed"
                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,0,0,0">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="1" BlurRadius="4" Opacity="0.2"/>
            </Border.Effect>
            <TextBlock x:Name="BubbleText" Foreground="#FF333333" FontSize="12"
                       TextWrapping="Wrap" MaxWidth="160" TextAlignment="Center"/>
        </Border>
        <Image x:Name="WhipImage" Width="60" Height="60" Visibility="Collapsed"
               HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <Image x:Name="CannonImage" Width="120" Height="120" Visibility="Collapsed"
               HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <Image x:Name="CowImage" Width="100" Height="80" Visibility="Collapsed"
               HorizontalAlignment="Left" VerticalAlignment="Top" RenderTransformOrigin="0.5,0.5"/>
        <Canvas x:Name="OverlayCanvas" Background="Transparent" Visibility="Collapsed"/>
    </Grid>
</Window>
